{
  "info": {
    "_postman_id": "e8d5d40f-79f9-4716-bdf4-a0e829f87452",
    "name": "restful-booker",
    "description": "API tests for the Restful Booker demo API ([https://restful-booker.herokuapp.com](https://restful-booker.herokuapp.com)).\n\nFlow: Get Auth Token → Create Booking → Get Booking → Update Booking → Delete Booking, plus negative tests (wrong token → 403, deleted booking → 404, empty body → expected 400).\n\nToken and booking ID are saved as collection variables, so the requests are chained.\n\nKnown bug: POST /booking with an empty body returns 500 instead of 400.\n\nRun: npm install, then npm run api (Newman + HTML report in reports/).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "2790377"
  },
  "item": [
    {
      "name": "Get Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status is 200\",function(){",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Token is received\",function (){",
              "    const token=pm.response.json().token;",
              "    pm.expect(token).to.not.be.null;",
              "    pm.expect(token).to.be.a(\"string\");",
              "    pm.collectionVariables.set(\"token\",token);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"Status is 200\",function(){",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Booking created\", () => pm.expect(body.bookingid).to.be.a(\"number\"));",
              "pm.collectionVariables.set(\"bookingId\", body.bookingid);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Sundram\",\n  \"lastname\": \"Test\",\n  \"totalprice\": 500,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-10\",\n    \"checkout\": \"2026-11-12\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "",
              "// for the status code tracking",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "",
              "",
              "// for the response time tracking",
              "",
              "pm.test(\"Response time is less than 2000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "",
              "//for first name is exist in string",
              "    pm.test(\"Has first name\",function(){",
              "        pm.expect(body.firstname).to.exist;",
              "        pm.expect(body.firstname).to.be.a(\"string\");",
              "        pm.expect(body.firstname).to.not.be.empty;",
              "    });",
              "",
              "//for last name is exist or not in string",
              "    pm.test(\"Has last name\",function(){",
              "        pm.expect(body.lastname).to.exist;",
              "    });",
              "",
              "",
              "//for number",
              "    pm.test(\"totalprice is a number\",function(){",
              "        pm.expect(body.totalprice).to.be.a(\"number\");",
              "",
              "    });",
              "",
              "",
              "//for boolean",
              "    pm.test(\"deposit paid is boolean\",function(){ ",
              "        pm.expect(body.depositpaid).to.be.a(\"boolean\");",
              "    });",
              "",
              "",
              "",
              "// for the date and time tracking",
              "pm.test(\"Checkin date is in correct format\",function(){",
              "    pm.expect(body.bookingdates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "",
              "});",
              "",
              "",
              "pm.test(\"Checkout date is in correct format\",function(){",
              "    pm.expect(body.bookingdates.checkout).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "});",
              "",
              "",
              "pm.test(\"Checkin is before checkout\",function(){",
              "    const checkintime=body.bookingdates.checkin;",
              "    const checkouttime=body.bookingdates.checkout;",
              "    pm.expect(checkintime).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "    pm.expect(checkouttime).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "    pm.expect(new Date(checkintime).getTime()).to.be.below(new Date(checkouttime).getTime());",
              "});",
              "",
              "",
              "",
              "",
              "pm.test(\"firstname is Sundram\",function(){",
              "    pm.expect(body.firstname).to.eql(\"Sundram\");",
              "});",
              "",
              "",
              "",
              "pm.test(\"lastname is Test\",function(){",
              "    pm.expect(body.lastname).to.eql(\"Test\");",
              "});",
              "",
              "pm.test(\"total price is 500\",function(){",
              "    pm.expect(body.totalprice).to.eql(500);",
              "});",
              "",
              "",
              "pm.test(\"depositpaid is true\",function(){",
              "    pm.expect(body.depositpaid).to.be.true;",
              "});",
              "",
              "pm.test(\"Checkin date is 2026-11-10\",function(){",
              "    pm.expect(body.bookingdates.checkin).to.eql(\"2026-11-10\");",
              "});",
              "",
              "pm.test(\"Checkout date is 2026-11-12\",function(){",
              "    pm.expect(body.bookingdates.checkout).to.eql(\"2026-11-12\");",
              "});",
              "",
              "pm.test(\"Has additionalneeds\",function(){",
              "pm.expect(body.additionalneeds).to.exist;",
              "});",
              "",
              "pm.test(\"Additionalneeds is Breakfast\",function(){",
              "pm.expect(body.additionalneeds).to.eql(\"Breakfast\");",
              "});",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      },
      "response": []
    },
