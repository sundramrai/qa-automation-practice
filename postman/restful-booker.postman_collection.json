          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response is successfull\", function(){",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body=pm.response.json();",
              "pm.test(\"last name is updated\",function(){",
              "    pm.expect(body.lastname).to.eql(\"Update\");",
              "});",
              "",
              "pm.test(\"totalprice is updated\",function(){",
              "    pm.expect(body.totalprice).to.eql(9999);",
              "});"
