    {
      "name": "Get Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "",
              "// for the status code tracking",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "",
              "",
              "// for the response time tracking",
              "",
              "pm.test(\"Response time is less than 2000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "// Booking have the booking id 1 ",
              "",
              "// pm.test(\"Response body contains bookingid 1\", function () {",
              "//     const json=pm.response.json();",
              "//     const exist=json.some(item=> item.bookingid===1);",
              "//     pm.expect(exist).to.be.true;",
              "//     });",
              "",
              "//Booking have the booking id 2",
              "",
              "//     pm.test(\"Response contain booking id 2\",function(){",
              "//         const json=pm.response.json();",
              "//         const exist=json.some(item=> item.bookingid===2);",
              "//         pm.expect(exist).to.be.true;",
              "//     });",
              "",
              "",
              "// for the length of array",
              "    pm.test(\"booking id length\",function(){",
              "        pm.expect(pm.request.json).to.have.length;",
              "    });",
              "",
              "// log the length of array in console",
              "    // const length=pm.response.json;",
              "    console.log(\"length of array is\",body.length);",
              "",
              "//for first name is exist in string",
              "    pm.test(\"having first name\",function(){",
              "        // const json=pm.response.json();",
              "        pm.expect(body.firstname).to.exist;",
              "        pm.expect(body.firstname).to.be.a(\"string\");",
              "        pm.expect(body.firstname).to.not.be.empty;",
              "    });",
              "",
              "//for last name is exist or not in string",
              "    pm.test(\"lastname name have in booking Id\",function(){",
              "        // const json=pm.response.json();",
              "        pm.expect(body.lastname).to.exist;",
              "    });",
              "",
              "",
              "//for number",
              "    pm.test(\"Total prize in number\",function(){",
              "        // const json=pm.response.json();",
              "        pm.expect(body.totalprice).to.be.a(\"number\");",
              "        console.log(\"prize values is\",body.totalprice);",
              "",
              "    });",
              "",
              "",
              "//for boolean",
              "    pm.test(\"Deposite paid is boolean\",function(){ ",
              "        // const json=pm.response.json();",
              "        pm.expect(body.depositpaid).to.be.true;",
              "    });",
              "",
              "",
              "// for the date and time tracking",
              "pm.test(\"Checkin date is in correct format\",function(){",
              "    // const json=pm.response.json();",
              "    pm.expect(body.bookingdates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "",
              "});",
              "",
              "",
              "pm.test(\"check out time is correct or not\",function(){",
              "    // const json=pm.response.json();",
              "    pm.expect(body.bookingdates.checkout).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "});",
              "",
              "",
              "pm.test(\"Checkin time is less than checkout time\",function(){",
              "    // const json=pm.response.json();",
              "    const checkintime=body.bookingdates.checkin;",
              "    const checkouttime=body.bookingdates.checkout;",
              "    pm.expect(checkintime).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "    pm.expect(checkouttime).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "    pm.expect(new Date(checkintime).getTime()).to.be.below(new Date(checkouttime).getTime());",
              "});",
              "",
              "",
              "",
              "",
              "pm.test(\"Firts name is Sundram or not\",function(){",
              "    pm.expect(body.firstname).to.eql(\"Sundram\");",
              "});",
              "",
              "",
              "",
              "pm.test(\"last name is test or not\",function(){",
              "    pm.expect(body.lastname).to.eql(\"Test\");",
              "});",
              "",
              "pm.test(\"total price is 500\",function(){",
              "    pm.expect(body.totalprice).to.eql(500);",
              "});",
              "",
              "",
              "pm.test(\"Deposite paid or not\",function(){",
              "    pm.expect(body.depositpaid).to.be.true;",
              "});",
              "",
              "pm.test(\"checkin time correct or not\",function(){",
              "    pm.expect(body.bookingdates.checkin).to.eql(\"2026-11-10\");",
              "});",
              "",
              "pm.test(\"checkout time is correect or not\",function(){",
              "    pm.expect(body.bookingdates.checkout).to.eql(\"2026-11-12\");",
              "});",
              "",
              "pm.test(\"check additonal neeeds\",function(){",
              "pm.expect(body.additionalneeds).to.exist;",
              "});",
              "",
              "pm.test(\"check additonal neeeds value\",function(){",
              "pm.expect(body.additionalneeds).to.eql(\"Breakfast\");",
              "});",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
